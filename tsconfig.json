{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "examples", "lab/materials.ts", "lab/specimens.ts", "lab/buildings.ts", "lab/buildingKinds.ts", "lab/figures.ts", "lab/slope.ts"]
}
